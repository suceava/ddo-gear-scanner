<Window x:Class="DdoGearScanner.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DDO Companion" Width="440" SizeToContent="Height"
        WindowStartupLocation="Manual" ResizeMode="NoResize"
        Icon="pack://application:,,,/appicon.ico"
        Background="{StaticResource BgWindow}" Foreground="{StaticResource Parchment}"
        TextOptions.TextFormattingMode="Display">
    <StackPanel Margin="28,26,28,24">
        <TextBlock Text="DDO Companion" FontSize="22" Style="{StaticResource Title}" HorizontalAlignment="Center" />
        <TextBlock Text="Sign in to sync your runs and loadouts to your account."
                   Foreground="{StaticResource TextMuted}" FontSize="12.5" TextWrapping="Wrap"
                   TextAlignment="Center" Margin="0,8,0,0" />

        <Button x:Name="SignInButton" Content="Sign in with Google" Click="SignIn_Click"
                Margin="0,20,0,0" HorizontalAlignment="Center" Padding="16,6" />
        <TextBlock x:Name="StatusText" Foreground="{StaticResource TextMuted}" FontSize="12" TextWrapping="Wrap"
                   TextAlignment="Center" Margin="0,12,0,0" />

        <Border BorderBrush="{StaticResource BorderDim}" BorderThickness="0,1,0,0" Margin="0,18,0,0" Padding="0,12,0,0">
            <Button Content="Quit" Click="Quit_Click" HorizontalAlignment="Center" />
        </Border>
    </StackPanel>
</Window>

<Window x:Class="DdoGearScanner.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Width="520" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Icon="pack://application:,,,/appicon.ico"
        Background="{StaticResource BgWindow}" Foreground="{StaticResource Parchment}"
        TextOptions.TextFormattingMode="Display">
    <StackPanel Margin="22,18,22,20">
        <TextBlock Text="Settings" FontSize="18" Style="{StaticResource Title}" />

        <Border Background="{StaticResource BgPanel}" BorderBrush="{StaticResource BorderDim}" BorderThickness="1"
                CornerRadius="4" Padding="14,10,14,14" Margin="0,14,0,0">
            <StackPanel>
                <TextBlock Text="Gear capture" Style="{StaticResource Section}" Margin="0,0,0,2" />
                <CheckBox Content="Show calibrated slot markers on the game while capture is on"
                          IsChecked="{Binding ShowSlotMarkers}" Foreground="{StaticResource Parchment}" />
                <TextBlock Text="Circles mark where the app expects your inventory slots — shown for a few seconds at capture start and whenever the inventory window moves, then they fade so tooltips stay readable. A red message appears if the inventory can't be located (captures would be skipped)."
                           Foreground="{StaticResource TextMuted}" FontSize="11.5" TextWrapping="Wrap" Margin="22,2,0,0" />
            </StackPanel>
        </Border>

        <Border Background="{StaticResource BgPanel}" BorderBrush="{StaticResource BorderDim}" BorderThickness="1"
                CornerRadius="4" Padding="14,10,14,14" Margin="0,12,0,0">
            <StackPanel>
                <TextBlock Text="AI (OpenRouter)" Style="{StaticResource Section}" Margin="0,0,0,2" />
                <TextBlock Foreground="{StaticResource TextMuted}" FontSize="11.5" TextWrapping="Wrap" Margin="0,2,0,8"
                           Text="One key powers the app's AI: reading captures here (gear tooltips, quest popups, your character — a fraction of a cent each, only at capture moments) and loadout recommendations on the web. Entering a key turns it on; clear it to turn it off. It's shared with your web account — set it in either place. Requires an OpenRouter account (openrouter.ai)." />

                <TextBlock Text="API key (shared with the web)" Foreground="{StaticResource TextMuted}" FontSize="12" Margin="0,4,0,0" />
                <TextBox x:Name="ApiKeyBox" Text="{Binding OpenRouterApiKey, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,0"
                         FontFamily="Consolas" />

                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <Button x:Name="TestButton" Content="Test connection" Click="Test_Click" />
                    <TextBlock x:Name="TestResult" VerticalAlignment="Center" Margin="10,0,0,0" FontSize="12"
                               Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" MaxWidth="300" />
                </StackPanel>

                <TextBlock Text="Model — this machine only" Foreground="{StaticResource TextMuted}" FontSize="12" Margin="0,14,0,0" />
                <TextBox Text="{Binding OpenRouterModel, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,0" FontFamily="Consolas" />
                <TextBlock Text="The vision model used for reading captures on this PC (local — not shared with the web). Any OpenRouter vision-capable id. Default: google/gemini-2.5-flash (fast + cheap)."
                           Foreground="{StaticResource TextMuted}" FontSize="10.5" TextWrapping="Wrap" Margin="0,2,0,0" />
            </StackPanel>
        </Border>

        <Button Content="Close" Click="Close_Click" HorizontalAlignment="Right" Margin="0,16,0,0" />
    </StackPanel>
</Window>

<Window x:Class="DdoGearScanner.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DDO Companion Overlay"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        SizeToContent="Manual"
        Left="-32000" Top="-32000" Width="1" Height="1">
    <!-- Root is hit-testable so the run HUD can catch clicks/drag; every NON-interactive layer opts out below,
         and the window-level WS_EX_TRANSPARENT toggle still gates input to only-when-over-the-HUD. -->
    <Grid>
        <Canvas x:Name="HighlightCanvas" IsHitTestVisible="False">
            <!-- Debug: persistent borders showing the calibrated run-tracker regions -->
            <Rectangle x:Name="DebugPopupBorder" Visibility="Collapsed" Stroke="#E6C66A" StrokeThickness="3" RadiusX="3" RadiusY="3" />
            <TextBlock x:Name="DebugPopupLabel" Visibility="Collapsed" Foreground="#E6C66A" FontFamily="Segoe UI"
                       FontWeight="Bold" FontSize="13" Text="① Quest-entry dialog" />
            <Rectangle x:Name="DebugTrackerBorder" Visibility="Collapsed" Stroke="#6AC6E6" StrokeThickness="3" RadiusX="3" RadiusY="3" />
            <TextBlock x:Name="DebugTrackerLabel" Visibility="Collapsed" Foreground="#6AC6E6" FontFamily="Segoe UI"
                       FontWeight="Bold" FontSize="13" Text="② Quest tracker" />
            <Rectangle x:Name="DebugChatBorder" Visibility="Collapsed" Stroke="#7AD67A" StrokeThickness="3" RadiusX="3" RadiusY="3" />
            <TextBlock x:Name="DebugChatLabel" Visibility="Collapsed" Foreground="#7AD67A" FontFamily="Segoe UI"
                       FontWeight="Bold" FontSize="13" Text="③ Chat log" />
            <Rectangle x:Name="RegionHighlight"
                       Visibility="Collapsed"
                       Stroke="#FFE0A030"
                       StrokeThickness="3"
                       RadiusX="4" RadiusY="4" />
        </Canvas>
        <!-- Gear capture feedback: shown while a session is on but the inventory paper-doll can't be
             located — the silent-failure case (moved window / different UI scale) made visible. -->
        <Border x:Name="SlotHintBorder"
                IsHitTestVisible="False"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,84,0,0"
                MaxWidth="760"
                Background="#E01A1010"
                BorderBrush="#FFE05C5C"
                BorderThickness="2"
                CornerRadius="6"
                Padding="18,10"
                Visibility="Collapsed">
            <TextBlock x:Name="SlotHintText" FontFamily="Segoe UI" FontSize="15" TextWrapping="Wrap"
                       Foreground="White" Text="" />
        </Border>
        <Border x:Name="ToastBorder"
                IsHitTestVisible="False"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,24,0,0"
                MaxWidth="680"
                Background="#E0101418"
                BorderBrush="#FF35C26B"
                BorderThickness="2"
                CornerRadius="6"
                Padding="18,12"
                Visibility="Collapsed">
            <TextBlock x:Name="ToastText"
                       FontFamily="Segoe UI"
                       FontSize="16"
                       TextWrapping="Wrap"
                       Foreground="White"
                       Text="" />
        </Border>
        <!-- Mini run readout, pinned to the game's bottom-right: one row, shown only WHILE a run is in progress
             (and briefly after completion so the XP isn't missed). Click-through like the rest of the overlay. -->
        <Border x:Name="RunHudBorder"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="0,0,20,20"
                Background="#E0101418"
                BorderBrush="#FFE0A030"
                BorderThickness="1.5"
                CornerRadius="6"
                Padding="12,7"
                Cursor="SizeAll"
                MouseLeftButtonDown="RunHud_MouseDown"
                Visibility="Collapsed">
            <StackPanel Orientation="Horizontal">
                <Ellipse x:Name="RunHudDot" Width="9" Height="9" Margin="0,0,8,0" VerticalAlignment="Center" Fill="#FF35C26B" />
                <TextBlock x:Name="RunHudName" FontFamily="Segoe UI" FontSize="14" FontWeight="SemiBold"
                           Foreground="White" VerticalAlignment="Center" MaxWidth="300" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="RunHudDiff" FontFamily="Segoe UI" FontSize="12" Foreground="#FFB9A97A"
                           VerticalAlignment="Center" Margin="7,0,0,0" />
                <TextBlock x:Name="RunHudTimer" FontFamily="Consolas" FontSize="15" FontWeight="Bold"
                           Foreground="#FFE6C66A" VerticalAlignment="Center" Margin="12,0,0,0" />
                <TextBlock x:Name="RunHudXp" FontFamily="Segoe UI" FontSize="14" FontWeight="Bold"
                           Foreground="#FF8FCF8A" VerticalAlignment="Center" Margin="12,0,0,0" Visibility="Collapsed" />
                <!-- Pause/Resume for the live run. Shown only while a run is active; label set in code (⏸/▶).
                     Cursor overrides the box's SizeAll so it reads as a button; its click is excluded from drag. -->
                <Button x:Name="HudPauseButton" Background="Transparent" BorderThickness="0" Padding="6,2" Margin="12,0,0,0"
                        VerticalAlignment="Center" Cursor="Hand" Click="HudPause_Click" Visibility="Collapsed" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
